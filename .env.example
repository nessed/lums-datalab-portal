# Copy to .env and fill in for your machine. Never commit .env.

# The ra-ship archive (previous RA work, reference docs, source corpus). Read-only.
RA_SHIP_DIR=C:/Users/<you>/Desktop/ra-ship

# Where source documents (PDF / Excel / API dumps) live. Read-only.
SOURCES_DIR=C:/Users/<you>/Desktop/ra-ship

# Local processing output. Git-ignored.
WORK_DIR=./work

# Supabase (working database). Service key stays server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# API keys for any unattended / scheduled jobs (crawlers, monitors).
LLM_API_KEY=
